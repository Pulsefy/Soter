{
  "openapi": "3.1.0",
  "info": {
    "title": "Soter API",
    "version": "1.0.0"
  },
  "paths": {
    "/aid/items": {
      "get": {
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/AidItem" }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AidItem": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "status": { "type": "string" }
        }
      }
    }
  }
}
