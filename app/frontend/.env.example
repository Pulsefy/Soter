# Backend API URL (required)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Stellar network: testnet | futurenet | mainnet (required)
NEXT_PUBLIC_STELLAR_NETWORK=testnet

# Active AidEscrow contract ID on the configured network.
# Used by receipt surfaces and the admin contract panel to build explorer links.
# Update this whenever the contract is redeployed.
# See app/onchain/deployments/registry.json for the authoritative value.
NEXT_PUBLIC_AID_ESCROW_CONTRACT_ID=CDSBJ27PKTNFTRW6OKPCVXDRUSSRUIQUG6DW5PUTKLDXTDT23NQIS6JG

# Optional: human-readable environment label shown in banners and footers
# NEXT_PUBLIC_ENV_NAME=dev

# Optional: show demo mode banner regardless of API health report
# NEXT_PUBLIC_DEMO_MODE=false
