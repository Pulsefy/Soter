{
  "$schema": "https://soter.dev/schemas/contract-interface/v1.json",
  "_comment": "Auto-generated contract interface artifact for AidEscrow. Do NOT edit by hand. Regenerate with: pnpm --filter backend run contract:export",
  "name": "aid_escrow",
  "version": "1",
  "types": {
    "PackageStatus": {
      "kind": "enum",
      "variants": ["Created", "Claimed", "Expired", "Cancelled", "Refunded"]
    },
    "ClaimStatus": {
      "kind": "enum",
      "variants": [
        "Success",
        "NotFound",
        "NotActive",
        "ClaimTooEarly",
        "Expired",
        "RequiresProof",
        "Unauthorized",
        "CampaignPaused",
        "TransferFailed",
        "CooldownActive"
      ]
    },
    "BatchAdminActionStatus": {
      "kind": "enum",
      "variants": [
        "Success",
        "NotFound",
        "InvalidState",
        "Expired",
        "NotExpired",
        "CampaignPaused",
        "TransferFailed"
      ]
    },
    "Error": {
      "kind": "error",
      "variants": [
        "NotInitialized",
        "AlreadyInitialized",
        "NotAuthorized",
        "InvalidAmount",
        "PackageNotFound",
        "PackageExpired",
        "PackageNotActive",
        "InsufficientFunds",
        "InsufficientSurplus",
        "ContractPaused",
        "ActionPaused",
        "InvalidToken",
        "TokenTransferFailed",
        "TokenNotAllowed",
        "InvalidConfig",
        "CampaignPaused",
        "InvalidPackageId",
        "DelegateNotSet",
        "DelegateExpired",
        "PackageAlreadyClaimed",
        "ClaimNotStarted",
        "MerkleProofRequired",
        "InvalidMerkleProof",
        "CooldownActive",
        "AdminTransferPending",
        "AdminTransferNotPending",
        "MaxDistributorsReached",
        "NotADistributor",
        "SurplusWithdrawalPending",
        "SurplusWithdrawalNotPending",
        "SurplusWithdrawalTimelockActive"
      ]
    },
    "Package": {
      "kind": "struct",
      "fields": {
        "id": "u64",
        "recipient": "Address",
        "amount": "i128",
        "token": "Address",
        "status": "PackageStatus",
        "created_at": "u64",
        "expires_at": "u64",
        "claim_starts_at": "u64",
        "metadata": "Map<Symbol, String>",
        "evidence_hash": "String"
      }
    },
    "Config": {
      "kind": "struct",
      "fields": {
        "min_amount": "i128",
        "max_expires_in": "u64",
        "allowed_tokens": "Vec<Address>",
        "claim_cooldown": "u64"
      }
    },
    "Aggregates": {
      "kind": "struct",
      "fields": {
        "total_committed": "i128",
        "total_claimed": "i128",
        "total_expired_cancelled": "i128"
      }
    },
    "PendingWithdrawal": {
      "kind": "struct",
      "fields": {
        "to": "Address",
        "token": "Address",
        "amount": "i128",
        "executable_at": "u64"
      }
    },
    "BatchClaimResult": {
      "kind": "struct",
      "fields": {
        "package_id": "u64",
        "status": "ClaimStatus",
        "amount": "i128"
      }
    },
    "BatchAdminActionResult": {
      "kind": "struct",
      "fields": {
        "package_id": "u64",
        "status": "BatchAdminActionStatus",
        "amount": "i128"
      }
    }
  },
