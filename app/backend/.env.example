# ── Database ──
DATABASE_URL=postgresql://soter_user:soter123@localhost:5432/soter_db

DATABASE_USER=soter_user
DATABASE=soter_db
DATABASE_PASSWORD=soter123

# ── Deployment Metadata ──
# Injected by CI/CD at build/deploy time so GET /api/v1/health can report
# which commit and build produced this running instance (used by the
# frontend to confirm it's talking to the expected backend deployment).
# Both are optional locally; the endpoint falls back to "unknown".
GIT_SHA=""
BUILD_TIMESTAMP=""

# ── Soroban / Stellar Testnet Configuration ──
# See docs/testnet-deployment-plan.md for canonical values.
# SOROBAN_NETWORK, STELLAR_RPC_URL, and STELLAR_NETWORK_PASSPHRASE are
# validated together at startup (see src/config/network-config.validation.ts).
# The app fails fast on boot if these don't agree (e.g. a mainnet passphrase
# paired with SOROBAN_NETWORK=testnet) instead of failing later on-chain.
# SOROBAN_NETWORK must be one of: testnet | futurenet | mainnet.
SOROBAN_NETWORK="testnet"
AID_ESCROW_CONTRACT_ID=""
SOROBAN_ADMIN_SECRET_KEY=""
STELLAR_RPC_URL="https://soroban-testnet.stellar.org"
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
ONCHAIN_ADAPTER="mock"  # "mock" for local dev, "soroban" for testnet

# ── Backend Secrets ──
AI_WEBHOOK_SECRET="change-me-to-a-strong-random-secret"
VERIFICATION_MODE="mock"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ── AI Service ──
AI_SERVICE_URL="http://localhost:8000"

# ── Readiness Health Checks (GET /api/v1/health/ready) ──
# Per-dependency timeouts, in milliseconds.
HEALTHCHECK_DB_TIMEOUT_MS=2000
HEALTHCHECK_REDIS_TIMEOUT_MS=1000
HEALTHCHECK_AI_TIMEOUT_MS=3000
HEALTHCHECK_STELLAR_TIMEOUT_MS=3000
# Whether an outage of each optional dependency should fail readiness (503)
# instead of only reporting a "degraded" status while still serving traffic.
HEALTHCHECK_REDIS_REQUIRED="false"
HEALTHCHECK_AI_REQUIRED="false"
HEALTHCHECK_STELLAR_REQUIRED="false"
# How long a readiness result is cached before dependencies are re-checked,
# so frequent orchestrator probes don't become a load source.
HEALTHCHECK_CACHE_TTL_MS=5000

# ── API Key Expiry Reminders ──
# Look-ahead window (days) for expiring_soon status + reminder job
API_KEY_EXPIRY_REMINDER_DAYS=14
# Minimum hours between reminders for the same key
API_KEY_EXPIRY_REMINDER_COOLDOWN_HOURS=24

# Response Cache TTL Settings (in seconds)
# Verification status/details - once decided, rarely changes
CACHE_TTL_VERIFICATION_STATUS=300
# Verification metrics - aggregate counts
CACHE_TTL_VERIFICATION_METRICS=60
# Aid package details - changes only on blockchain events
CACHE_TTL_AID_PACKAGE_DETAILS=300
# Aid package statistics - aggregate data
CACHE_TTL_AID_PACKAGE_STATS=600
# Transaction status - immutable once confirmed
CACHE_TTL_TRANSACTION_STATUS=1800
# Global analytics - expensive queries
CACHE_TTL_ANALYTICS_GLOBAL=600
# Map data - geographic aggregations
CACHE_TTL_ANALYTICS_MAP_DATA=900
# Internal notes - staff-only
CACHE_TTL_INTERNAL_NOTES=120
# User verification history - append-only
CACHE_TTL_USER_VERIFICATION_HISTORY=180
# AI task status - polled frequently
CACHE_TTL_AI_TASK_STATUS=30

# ── Cost-Aware Rate Limiting Configuration ──
# All values are requests per minute per IP/API key
# Verification endpoints are rate-limited due to high cost (external API calls)
# Health and docs endpoints are never rate-limited

# Strictest: OTP/email/phone operations
# These trigger external SMS/email providers and are most expensive
# Default: 20 requests per minute
THROTTLE_VERIFY_OTP_LIMIT=20
THROTTLE_VERIFY_OTP_TTL=60

# Strict: General verification operations (document upload, verification enqueue)
# Default: 30 requests per minute
THROTTLE_VERIFY_LIMIT=30
THROTTLE_VERIFY_TTL=60

# Moderate: General API endpoints (standard CRUD, queries, business logic)
# Default: 100 requests per minute
THROTTLE_GENERAL_LIMIT=100
THROTTLE_GENERAL_TTL=60

# Search endpoints: Read-only queries
# Default: 50 requests per minute
THROTTLE_SEARCH_LIMIT=50
THROTTLE_SEARCH_TTL=60

# ── Rate Limiting: Multi-Instance Support ──
# ThrottlerModule uses Redis for distributed rate limiting across multiple instances
# If Redis is unavailable, falls back to in-memory storage (not recommended for production)
# REDIS_HOST and REDIS_PORT are already configured above

# ── Release Version Configuration ──
# Missing force-upgrade values default safely to false.

# Web release configuration
RELEASE_WEB_CURRENT_VERSION="1.4.0"
RELEASE_WEB_LATEST_VERSION="1.5.0"
RELEASE_WEB_MIN_REQUIRED_VERSION="1.4.0"
RELEASE_WEB_FORCE_UPGRADE="false"
RELEASE_WEB_NOTES_VERSION="1.5.0"
RELEASE_WEB_NOTES_TITLE="What's New"
RELEASE_WEB_NOTES_CHANGES='["Improved beneficiary verification","Faster voucher loading","Offline sync improvements","Enhanced security measures"]'

# Mobile release configuration
# Used by mobile, iOS, and Android platform requests.
RELEASE_MOBILE_CURRENT_VERSION="1.4.0"
RELEASE_MOBILE_LATEST_VERSION="1.5.0"
RELEASE_MOBILE_MIN_REQUIRED_VERSION="1.4.0"
RELEASE_MOBILE_FORCE_UPGRADE="false"
RELEASE_MOBILE_NOTES_VERSION="1.5.0"
RELEASE_MOBILE_NOTES_TITLE="What's New"
RELEASE_MOBILE_NOTES_CHANGES='["Improved beneficiary verification","Faster voucher loading","Offline sync improvements","Enhanced security measures"]'

# Mobile store destinations
RELEASE_IOS_STORE_URL="https://apps.apple.com/app/soter"
RELEASE_ANDROID_STORE_URL="https://play.google.com/store/apps/details?id=org.pulsefy.soter.mobile"
