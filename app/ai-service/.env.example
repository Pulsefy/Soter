# Soter AI Service Environment Variables
# Copy this file to .env and fill in your actual values

# API Keys (at least one is required for AI features)
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENAI_MODEL=gpt-4o-mini
GROQ_MODEL=llama-3.3-70b-versatile
AI_DETERMINISTIC_MODE=false
LLM_TIMEOUT_SECONDS=30

# Request safety limits
# Maximum body size accepted by /v1/* and legacy /ai/* write endpoints.
MAX_REQUEST_BODY_BYTES=10485760
# Caller-supplied humanitarian verification timeouts are clamped to this value.
MAX_REQUEST_TIMEOUT_SECONDS=60

# Demo / contributor mode
# Set TEST_PROVIDER_MODE=true to use fixture-driven responses without any API
# keys.  This enables "demo mode" so contributors can run the service locally
# without credentials.  All AI responses will come from the fixtures/ directory
# and every API response will carry the header:  X-Demo-Mode: fixture
# The frontend reads NEXT_PUBLIC_DEMO_MODE to show a visible banner.
TEST_PROVIDER_MODE=false

# Application Settings
# APP_ENV values: development, staging, production, test
# Use staging for stable end-to-end testnet/testing with safe defaults.
APP_ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# Redis Configuration (for Celery task queue and response caching)
# Format: redis://[username]:[password]@[host]:[port]/[database]
REDIS_URL=redis://localhost:6379/0

# Backend Webhook URL (for notifying NestJS backend of task completion)
# Default: http://localhost:3000/api/v1/webhooks/ai-verification
BACKEND_WEBHOOK_URL=http://localhost:3000/api/v1/webhooks/ai-verification

# Shared HMAC-SHA256 secret for signing outbound webhook payloads.
# Must match AI_WEBHOOK_SECRET in the NestJS backend .env.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AI_WEBHOOK_SECRET=change-me-to-a-strong-random-secret

# Proof-of-life defaults
# Confidence threshold range: 0.0 to 1.0
PROOF_OF_LIFE_CONFIDENCE_THRESHOLD=0.65
# Minimum face bounding-box size in pixels for detection
PROOF_OF_LIFE_MIN_FACE_SIZE=80

# Cache TTL Settings (in seconds)
# Task status polling - short TTL for responsive updates
CACHE_TTL_TASK_STATUS=30
# Artifact access metadata - moderate TTL
CACHE_TTL_ARTIFACT_ACCESS=60

# Decision Audit Records (issue #990)
# Every humanitarian verification and fraud decision is written to a durable,
# redacted audit record so a disbursement decision can be reconstructed later.
# Set to false only in throwaway environments - audit records are the system of
# record for why a claim was approved or rejected.
DECISION_AUDIT_ENABLED=true
# Append-only JSON Lines log. Must live on a persistent volume in production
# (a container-local path is lost on redeploy).
DECISION_AUDIT_PATH=./audit/decision_audit.jsonl
# How long audit records are retained, in days. Records older than this are
# dropped by the retention sweep that runs at startup and periodically while
# serving. Set to 0 to retain forever. See DECISION_AUDIT.md.
DECISION_AUDIT_RETENTION_DAYS=90
